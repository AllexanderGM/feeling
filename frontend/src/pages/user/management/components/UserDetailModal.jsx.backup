import { memo, useMemo } from 'react'
import { Modal, ModalContent, ModalHeader, ModalBody, ModalFooter, Button, Chip, Avatar, Progress } from '@heroui/react'
import {
  User,
  Mail,
  MapPin,
  Calendar,
  Shield,
  Star,
  CheckCircle,
  XCircle,
  UserIcon,
  Eye,
  Heart,
  Users,
  Zap,
  Lock,
  Bell,
  Globe,
  Search,
  Phone,
  AlertTriangle,
  CreditCard,
  Info
} from 'lucide-react'
import { USER_INTEREST_COLORS, USER_ROLE_COLORS } from '@constants/tableConstants.js'
import { formatJavaDateForDisplay, daysSinceJavaDate, calculateAgeFromJavaDate } from '@utils/dateUtils.js'

// Helper function to calculate age
const calculateAge = birthDate => {
  if (!birthDate) return 'N/A'
  try {
    return calculateAgeFromJavaDate(birthDate)
  } catch {
    return 'N/A'
  }
}

const formatLastActive = lastActiveArray => {
  if (!lastActiveArray || !Array.isArray(lastActiveArray)) return 'Nunca'
  try {
    return formatJavaDateForDisplay(lastActiveArray)
  } catch {
    return 'Nunca'
  }
}

const UserDetailModal = memo(({ isOpen, onClose, selectedUser }) => {
  // Computed data from selectedUser
  const userData = useMemo(() => {
    if (!selectedUser) return null

    const { user, status, privacy, metrics, matches, auth, notifications } = selectedUser

    return {
      // Basic Info
      name: `${user?.name || ''} ${user?.lastName || ''}`.trim(),
      email: user?.email,
      phone: user?.phone ? `${user.phoneCode || ''} ${user.phone}`.trim() : 'No especificado',
      age: calculateAge(user?.dateOfBirth),
      location: `${user?.city || ''}, ${user?.country || ''}`.trim(),
      mainImage: user?.mainImage || user?.image,
      description: user?.description,

      // Status
      verified: status?.verified,
      approved: status?.approved,
      role: status?.role,
      profileComplete: status?.profileComplete,
      configurationCompleted: status?.configurationCompleted,
      lastActive: formatLastActive(status?.lastActive),
      createdAt: formatJavaDateForDisplay(status?.createdAt),
      daysSinceCreated: daysSinceJavaDate(status?.createdAt),
      accountDeactivated: status?.accountDeactivated,

      // Privacy
      publicAccount: privacy?.publicAccount,
      searchVisibility: privacy?.searchVisibility,
      locationPublic: privacy?.locationPublic,
      showAge: privacy?.showAge,
      showLocation: privacy?.showLocation,
      showPhone: privacy?.showPhone,
      showMeInSearch: privacy?.showMeInSearch,

      // Metrics
      profileViews: metrics?.profileViews || 0,
      likesReceived: metrics?.likesReceived || 0,
      matchesCount: metrics?.matchesCount || 0,
      popularityScore: metrics?.popularityScore || 0,
      profileCompleteness: metrics?.profileCompleteness || 0,

      // Matches
      availableAttempts: matches?.availableAttempts || 0,
      reservedAttempts: matches?.reservedAttempts || 0,
      totalRemainingAttempts: matches?.totalRemainingAttempts || 0,
      todayMatches: matches?.todayMatches || 0,
      sentMatches: matches?.sentMatches || 0,
      receivedMatches: matches?.receivedMatches || 0,
      pendingSent: matches?.pendingSent || 0,
      pendingReceived: matches?.pendingReceived || 0,
      accepted: matches?.accepted || 0,
      favorites: matches?.favorites || 0,

      // Auth
      authProvider: auth?.userAuthProvider,
      externalId: auth?.externalId,

      // Notifications
      emailEnabled: notifications?.notificationsEmailEnabled,
      phoneEnabled: notifications?.notificationsPhoneEnabled,
      matchesEnabled: notifications?.notificationsMatchesEnabled,
      eventsEnabled: notifications?.notificationsEventsEnabled,

      // Personal Info
      profession: user?.profession,
      document: user?.document,
      categoryInterest: user?.categoryInterest,
      gender: user?.gender,
      tags: user?.tags,
      maritalStatus: user?.maritalStatus,
      height: user?.height,
      eyeColor: user?.eyeColor,
      hairColor: user?.hairColor,
      bodyType: user?.bodyType,
      education: user?.education,
      religion: user?.religion,
      sexualRole: user?.sexualRole,
      relationshipType: user?.relationshipType,

      // Preferences
      agePreferenceMin: user?.agePreferenceMin,
      agePreferenceMax: user?.agePreferenceMax,
      locationPreferenceRadius: user?.locationPreferenceRadius
    }
  }, [selectedUser])

  if (!userData) return null

  return (
    <Modal
      classNames={{
        backdrop: 'bg-gray-900/50 backdrop-blur-sm',
        base: 'bg-gray-900 border border-gray-700 max-h-[90vh]',
        header: 'border-b border-gray-700 flex-shrink-0',
        body: 'py-4 px-6 overflow-y-auto',
        footer: 'border-t border-gray-700 flex-shrink-0'
      }}
      isOpen={isOpen}
      scrollBehavior='inside'
      size='5xl'
      onClose={onClose}>
      <ModalContent className='max-h-[90vh]'>
        <ModalHeader className='flex flex-col gap-1 pb-4'>
          <div className='flex items-center gap-3'>
            <div className='w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center'>
              <Eye className='w-4 h-4 text-blue-400' />
            </div>
            <div>
              <h3 className='text-xl font-semibold text-gray-200'>Estado General de la Cuenta</h3>
              <p className='text-sm text-gray-400'>Vista completa del perfil del usuario</p>
            </div>
          </div>
        </ModalHeader>

        <ModalBody className='space-y-4 px-6 py-0 mb-4'>
          {/* Profile Header */}
          <div className='bg-gray-800 border border-gray-700 rounded-lg p-6'>
            <div className='flex items-start gap-6'>
              <Avatar className='w-24 h-24 flex-shrink-0' icon={<UserIcon className='w-12 h-12' />} src={userData.mainImage} />
              <div className='flex-1 space-y-3'>
                <div>
                  <h2 className='text-2xl font-bold text-white'>{userData.name}</h2>
                  <div className='flex items-center gap-4 mt-2 text-sm text-gray-300'>
                    <div className='flex items-center gap-1'>
                      <Calendar className='w-4 h-4' />
                      {userData.age} años
                    </div>
                    <div className='flex items-center gap-1'>
                      <MapPin className='w-4 h-4' />
                      {userData.location}
                    </div>
                  </div>
                </div>
                <div className='flex items-center gap-2 text-sm text-gray-400'>
                  <Mail className='w-4 h-4' />
                  {userData.email}
                </div>
                <div className='flex items-center gap-4 text-xs text-gray-400'>
                  <div className='flex items-center gap-1'>
                    <Info className='w-3 h-3' />
                    Miembro desde {userData.createdAt}
                  </div>
                  <div className='flex items-center gap-1'>
                    <Zap className='w-3 h-3' />
                    Última actividad: {userData.lastActive}
                  </div>
                </div>
              </div>
            </div>

            {/* Profile Completeness Bar */}
            <div className='mt-4'>
              <div className='flex items-center justify-between text-sm mb-2'>
                <span className='text-gray-400'>Completitud del perfil</span>
                <span className='text-white font-semibold'>{userData.profileCompleteness}%</span>
              </div>
              <Progress
                classNames={{
                  base: 'max-w-full',
                  indicator: 'bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500'
                }}
                size='md'
                value={userData.profileCompleteness}
              />
            </div>
          </div>

          {/* Privacidad y Configuración */}
          <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
            <div className='flex items-center gap-2 mb-4'>
              <Lock className='w-5 h-5 text-purple-400' />
              <h4 className='text-lg font-semibold text-white'>Privacidad y Configuración</h4>
            </div>
            <div className='grid grid-cols-2 gap-3'>
              <div className='flex items-center justify-between bg-gray-900 p-3 rounded-lg'>
                <div className='flex items-center gap-2'>
                  <Globe className='w-4 h-4 text-gray-400' />
                  <span className='text-sm text-gray-300'>Perfil Público</span>
                </div>
                <Chip color={userData.publicAccount ? 'success' : 'danger'} size='sm' variant='dot'>
                  {userData.publicAccount ? 'Sí' : 'No'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-3 rounded-lg'>
                <div className='flex items-center gap-2'>
                  <Search className='w-4 h-4 text-gray-400' />
                  <span className='text-sm text-gray-300'>Búsqueda Visible</span>
                </div>
                <Chip color={userData.searchVisibility ? 'success' : 'danger'} size='sm' variant='dot'>
                  {userData.searchVisibility ? 'Sí' : 'No'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-3 rounded-lg'>
                <div className='flex items-center gap-2'>
                  <MapPin className='w-4 h-4 text-gray-400' />
                  <span className='text-sm text-gray-300'>Ubicación Compartida</span>
                </div>
                <Chip color={userData.locationPublic ? 'success' : 'danger'} size='sm' variant='dot'>
                  {userData.locationPublic ? 'Sí' : 'No'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-3 rounded-lg'>
                <div className='flex items-center gap-2'>
                  <CheckCircle className='w-4 h-4 text-gray-400' />
                  <span className='text-sm text-gray-300'>Cuenta Verificada</span>
                </div>
                <Chip color={userData.verified ? 'success' : 'warning'} size='sm' variant='dot'>
                  {userData.verified ? 'Verificado' : 'Sin verificar'}
                </Chip>
              </div>
            </div>
          </div>

          {/* Verificación y Aprobación */}
          <div className='grid grid-cols-2 gap-4'>
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <CheckCircle className='w-5 h-5 text-green-400' />
                <h4 className='text-base font-semibold text-white'>Verificación</h4>
              </div>
              <div className='text-center py-3'>
                <Chip color={userData.verified ? 'success' : 'warning'} size='lg' variant='flat'>
                  {userData.verified ? 'Verificado' : 'Sin verificar'}
                </Chip>
              </div>
            </div>

            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <Shield className='w-5 h-5 text-blue-400' />
                <h4 className='text-base font-semibold text-white'>Aprobación</h4>
              </div>
              <div className='text-center py-3'>
                <Chip color={userData.approved ? 'success' : 'warning'} size='lg' variant='flat'>
                  {userData.approved ? 'Aprobado' : 'Pendiente'}
                </Chip>
              </div>
            </div>
          </div>

          {/* Intentos de Match */}
          <div className='bg-gradient-to-br from-purple-900/30 to-pink-900/30 border border-purple-500/20 rounded-lg p-4'>
            <div className='flex items-center gap-2 mb-4'>
              <div className='w-10 h-10 bg-purple-500/20 rounded-lg flex items-center justify-center'>
                <Zap className='w-5 h-5 text-purple-400' />
              </div>
              <div className='flex-1'>
                <h4 className='text-lg font-semibold text-white flex items-center gap-2'>
                  Intentos de Match
                  <CreditCard className='w-4 h-4 text-yellow-400' />
                </h4>
              </div>
            </div>

            <div className='grid grid-cols-5 gap-3 mb-4'>
              <div className='bg-gradient-to-br from-green-500/10 to-emerald-500/10 border border-green-500/20 rounded-lg p-3 text-center'>
                <div className='text-2xl font-bold text-green-400'>{userData.availableAttempts}</div>
                <div className='text-xs text-gray-400'>Disponibles</div>
              </div>
              <div className='bg-gradient-to-br from-yellow-500/10 to-orange-500/10 border border-yellow-500/20 rounded-lg p-3 text-center'>
                <div className='text-2xl font-bold text-yellow-400'>{userData.reservedAttempts}</div>
                <div className='text-xs text-gray-400'>Reservados</div>
              </div>
              <div className='bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-purple-500/20 rounded-lg p-3 text-center'>
                <div className='text-2xl font-bold text-purple-400'>{userData.totalRemainingAttempts}</div>
                <div className='text-xs text-gray-400'>Saldo total</div>
              </div>
              <div className='bg-gradient-to-br from-blue-500/10 to-cyan-500/10 border border-blue-500/20 rounded-lg p-3 text-center'>
                <div className='text-2xl font-bold text-blue-400'>{userData.accepted}</div>
                <div className='text-xs text-gray-400'>Aceptados</div>
              </div>
              <div className='bg-gradient-to-br from-pink-500/10 to-rose-500/10 border border-pink-500/20 rounded-lg p-3 text-center'>
                <div className='text-2xl font-bold text-pink-400'>{userData.todayMatches}</div>
                <div className='text-xs text-gray-400'>Hoy</div>
              </div>
            </div>

            <div className='bg-gray-900/50 rounded-lg p-3'>
              <div className='text-xs text-gray-400 mb-2'>Intentos comprometidos</div>
              <Progress
                classNames={{
                  indicator: 'bg-gradient-to-r from-purple-500 to-pink-500'
                }}
                maxValue={userData.totalRemainingAttempts || 1}
                size='sm'
                value={userData.totalRemainingAttempts - userData.availableAttempts}
              />
              <div className='text-xs text-gray-400 mt-1'>
                {userData.totalRemainingAttempts - userData.availableAttempts} / {userData.totalRemainingAttempts}
              </div>
            </div>

            <div className='grid grid-cols-5 gap-2 mt-3'>
              <div className='bg-gray-900/30 rounded-lg p-2 text-center'>
                <div className='text-sm font-semibold text-white'>{userData.sentMatches}</div>
                <div className='text-xs text-gray-400'>Enviados</div>
              </div>
              <div className='bg-gray-900/30 rounded-lg p-2 text-center'>
                <div className='text-sm font-semibold text-white'>{userData.receivedMatches}</div>
                <div className='text-xs text-gray-400'>Recibidos</div>
              </div>
              <div className='bg-gray-900/30 rounded-lg p-2 text-center'>
                <div className='text-sm font-semibold text-white'>{userData.pendingSent}</div>
                <div className='text-xs text-gray-400'>Pendientes enviados</div>
              </div>
              <div className='bg-gray-900/30 rounded-lg p-2 text-center'>
                <div className='text-sm font-semibold text-white'>{userData.pendingReceived}</div>
                <div className='text-xs text-gray-400'>Pendientes recibidos</div>
              </div>
              <div className='bg-gray-900/30 rounded-lg p-2 text-center'>
                <div className='text-sm font-semibold text-white'>{userData.favorites}</div>
                <div className='text-xs text-gray-400'>Favoritos</div>
              </div>
            </div>
          </div>

          {/* Métricas del Perfil */}
          <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
            <div className='flex items-center gap-2 mb-4'>
              <Star className='w-5 h-5 text-purple-400' />
              <h4 className='text-lg font-semibold text-white'>Métricas del Perfil</h4>
            </div>
            <div className='grid grid-cols-4 gap-3'>
              <div className='bg-gradient-to-br from-blue-500/10 to-cyan-500/10 border border-blue-500/20 rounded-lg p-4 text-center'>
                <div className='flex items-center justify-center gap-1 mb-2'>
                  <Eye className='w-4 h-4 text-blue-400' />
                </div>
                <div className='text-2xl font-bold text-blue-300'>{userData.profileViews}</div>
                <div className='text-xs text-gray-400'>Visualizaciones</div>
              </div>
              <div className='bg-gradient-to-br from-pink-500/10 to-rose-500/10 border border-pink-500/20 rounded-lg p-4 text-center'>
                <div className='flex items-center justify-center gap-1 mb-2'>
                  <Heart className='w-4 h-4 text-pink-400' />
                </div>
                <div className='text-2xl font-bold text-pink-300'>{userData.likesReceived}</div>
                <div className='text-xs text-gray-400'>Likes</div>
              </div>
              <div className='bg-gradient-to-br from-purple-500/10 to-indigo-500/10 border border-purple-500/20 rounded-lg p-4 text-center'>
                <div className='flex items-center justify-center gap-1 mb-2'>
                  <Users className='w-4 h-4 text-purple-400' />
                </div>
                <div className='text-2xl font-bold text-purple-300'>{userData.matchesCount}</div>
                <div className='text-xs text-gray-400'>Matches</div>
              </div>
              <div className='bg-gradient-to-br from-yellow-500/10 to-amber-500/10 border border-yellow-500/20 rounded-lg p-4 text-center'>
                <div className='flex items-center justify-center gap-1 mb-2'>
                  <Zap className='w-4 h-4 text-yellow-400' />
                </div>
                <div className='text-2xl font-bold text-yellow-300'>{userData.popularityScore.toFixed(1)}</div>
                <div className='text-xs text-gray-400'>Popularidad</div>
              </div>
            </div>
          </div>

          {/* Información Personal Completa */}
          <div className='grid grid-cols-2 gap-4'>
            {/* Información Básica */}
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <User className='w-4 h-4 text-blue-400' />
                <h5 className='text-sm font-semibold text-white'>Información Básica</h5>
              </div>
              <div className='space-y-2 text-xs'>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Profesión:</span>
                  <span className='text-gray-200'>{userData.profession || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Documento:</span>
                  <span className='text-gray-200'>{userData.document || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Teléfono:</span>
                  <span className='text-gray-200'>{userData.phone}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Género:</span>
                  <span className='text-gray-200'>{userData.gender || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Estado Civil:</span>
                  <span className='text-gray-200'>{userData.maritalStatus || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Categoría Interés:</span>
                  <Chip color={USER_INTEREST_COLORS[userData.categoryInterest] || 'default'} size='sm' variant='flat'>
                    {userData.categoryInterest || 'N/A'}
                  </Chip>
                </div>
              </div>
            </div>

            {/* Características Físicas */}
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <Star className='w-4 h-4 text-purple-400' />
                <h5 className='text-sm font-semibold text-white'>Características Físicas</h5>
              </div>
              <div className='space-y-2 text-xs'>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Altura:</span>
                  <span className='text-gray-200'>{userData.height ? `${userData.height} cm` : 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Color de Ojos:</span>
                  <span className='text-gray-200'>{userData.eyeColor || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Color de Cabello:</span>
                  <span className='text-gray-200'>{userData.hairColor || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Tipo de Cuerpo:</span>
                  <span className='text-gray-200'>{userData.bodyType || 'No especificado'}</span>
                </div>
              </div>
            </div>

            {/* Educación y Religión */}
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <Shield className='w-4 h-4 text-green-400' />
                <h5 className='text-sm font-semibold text-white'>Educación y Espiritualidad</h5>
              </div>
              <div className='space-y-2 text-xs'>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Educación:</span>
                  <span className='text-gray-200'>{userData.education || 'No especificado'}</span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Religión:</span>
                  <span className='text-gray-200'>{userData.religion || 'No especificado'}</span>
                </div>
                {userData.sexualRole && (
                  <div className='flex justify-between'>
                    <span className='text-gray-400'>Rol Sexual:</span>
                    <span className='text-gray-200'>{userData.sexualRole}</span>
                  </div>
                )}
                {userData.relationshipType && (
                  <div className='flex justify-between'>
                    <span className='text-gray-400'>Tipo de Relación:</span>
                    <span className='text-gray-200'>{userData.relationshipType}</span>
                  </div>
                )}
              </div>
            </div>

            {/* Preferencias de Match */}
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <Heart className='w-4 h-4 text-pink-400' />
                <h5 className='text-sm font-semibold text-white'>Preferencias de Match</h5>
              </div>
              <div className='space-y-2 text-xs'>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Rango de Edad:</span>
                  <span className='text-gray-200'>
                    {userData.agePreferenceMin} - {userData.agePreferenceMax} años
                  </span>
                </div>
                <div className='flex justify-between'>
                  <span className='text-gray-400'>Radio de Ubicación:</span>
                  <span className='text-gray-200'>{userData.locationPreferenceRadius} km</span>
                </div>
              </div>
            </div>
          </div>

          {/* Tags */}
          {userData.tags && userData.tags.length > 0 && (
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <Star className='w-4 h-4 text-yellow-400' />
                <h5 className='text-sm font-semibold text-white'>Intereses y Etiquetas</h5>
              </div>
              <div className='flex flex-wrap gap-2'>
                {userData.tags.map((tag, index) => (
                  <Chip key={index} color='primary' size='sm' variant='flat'>
                    {tag}
                  </Chip>
                ))}
              </div>
            </div>
          )}

          {/* Autenticación */}
          <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
            <div className='flex items-center gap-2 mb-3'>
              <Shield className='w-4 h-4 text-blue-400' />
              <h5 className='text-sm font-semibold text-white'>Autenticación</h5>
            </div>
            <div className='grid grid-cols-2 gap-3 text-xs'>
              <div className='flex justify-between'>
                <span className='text-gray-400'>Proveedor:</span>
                <Chip color={userData.authProvider === 'GOOGLE' ? 'success' : 'default'} size='sm' variant='flat'>
                  {userData.authProvider}
                </Chip>
              </div>
              <div className='flex justify-between'>
                <span className='text-gray-400'>Rol:</span>
                <Chip color={USER_ROLE_COLORS[userData.role] || 'default'} size='sm' variant='flat'>
                  {userData.role}
                </Chip>
              </div>
            </div>
          </div>

          {/* Notificaciones */}
          <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
            <div className='flex items-center gap-2 mb-3'>
              <Bell className='w-4 h-4 text-yellow-400' />
              <h5 className='text-sm font-semibold text-white'>Preferencias de Notificaciones</h5>
            </div>
            <div className='grid grid-cols-2 gap-2'>
              <div className='flex items-center justify-between bg-gray-900 p-2 rounded'>
                <span className='text-xs text-gray-300'>Email</span>
                <Chip color={userData.emailEnabled ? 'success' : 'default'} size='sm' variant='dot'>
                  {userData.emailEnabled ? 'On' : 'Off'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-2 rounded'>
                <span className='text-xs text-gray-300'>Teléfono</span>
                <Chip color={userData.phoneEnabled ? 'success' : 'default'} size='sm' variant='dot'>
                  {userData.phoneEnabled ? 'On' : 'Off'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-2 rounded'>
                <span className='text-xs text-gray-300'>Matches</span>
                <Chip color={userData.matchesEnabled ? 'success' : 'default'} size='sm' variant='dot'>
                  {userData.matchesEnabled ? 'On' : 'Off'}
                </Chip>
              </div>
              <div className='flex items-center justify-between bg-gray-900 p-2 rounded'>
                <span className='text-xs text-gray-300'>Eventos</span>
                <Chip color={userData.eventsEnabled ? 'success' : 'default'} size='sm' variant='dot'>
                  {userData.eventsEnabled ? 'On' : 'Off'}
                </Chip>
              </div>
            </div>
          </div>

          {/* Descripción del perfil */}
          {userData.description && (
            <div className='bg-gray-800 border border-gray-700 rounded-lg p-4'>
              <div className='flex items-center gap-2 mb-3'>
                <User className='w-4 h-4 text-indigo-400' />
                <h5 className='text-sm font-semibold text-white'>Sobre mí</h5>
              </div>
              <div className='bg-gray-900 p-3 rounded-lg'>
                <p className='text-sm text-gray-200 whitespace-pre-wrap'>{userData.description}</p>
              </div>
            </div>
          )}

          {/* Cuenta Desactivada Warning */}
          {userData.accountDeactivated && (
            <div className='bg-red-500/10 border border-red-500/20 rounded-lg p-4'>
              <div className='flex items-center gap-2'>
                <AlertTriangle className='w-5 h-5 text-red-400' />
                <span className='text-sm font-semibold text-red-300'>Esta cuenta está desactivada</span>
              </div>
            </div>
          )}
        </ModalBody>

        <ModalFooter className='pt-4'>
          <Button color='danger' variant='light' onPress={onClose}>
            Cerrar
          </Button>
        </ModalFooter>
      </ModalContent>
    </Modal>
  )
})

UserDetailModal.displayName = 'UserDetailModal'

export default UserDetailModal
